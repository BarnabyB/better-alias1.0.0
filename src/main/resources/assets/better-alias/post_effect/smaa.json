          "target": "minecraft:main"
        }
      ],
      "output": "edges"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "better-alias:post/smaa_weights",
      "inputs": [
        {
          "sampler_name": "Edges",
          "target": "edges",
